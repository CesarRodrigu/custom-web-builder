{
  "name": "generator",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "run-s test:unit test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:coverage": "run-s test:unit:coverage test:e2e",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:debug": "playwright test --debug",
    "test:codegen": "playwright codegen",
    "metadata": "node scripts/capture-metadata.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "react-doctor": "pnpx react-doctor@latest --json-compact --yes",
    "check": "run-p lint format:check react-doctor",
    "check:fix": "run-s lint:fix format",
    "check:all": "run-p test check",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.8",
    "@astrojs/sitemap": "^3.7.6",
    "@base-ui/react": "^1.9.0",
    "@custom-web-builder/shared": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.2",
    "eslint-plugin-jsdoc": "^65.5.6",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "npm-run-all2": "^9.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
