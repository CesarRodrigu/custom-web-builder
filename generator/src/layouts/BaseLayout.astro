---
import { defaultLocale, type Locale } from "@/config/site";
import { DARK_THEME_CLASS, THEME_STORAGE_KEY, Theme } from "@/config/theme";
import Head from "@/components/Head.astro";
import "@/styles/global.css";

interface Props {
  /** Title of the page, without the site name. */
  title?: string;
  /** Meta description of the page; one derived from the title is used when omitted. */
  description?: string;
  /** Language of the page content; the locale of the current route is used when omitted. */
  lang?: Locale;
}

const { title, description, lang } = Astro.props;
const routeLocale = Astro.currentLocale as Locale | undefined;
const documentLang = lang ?? routeLocale ?? defaultLocale;
---

<script define:vars={{ Theme, THEME_STORAGE_KEY, DARK_THEME_CLASS }} is:inline>
  const getThemePreference = () => {
    if (
      typeof localStorage !== "undefined" &&
      localStorage.getItem(THEME_STORAGE_KEY)
    ) {
      return localStorage.getItem(THEME_STORAGE_KEY);
    }
    return window.matchMedia(`(prefers-color-scheme: ${Theme.Dark})`).matches
      ? Theme.Dark
      : Theme.Light;
  };
  const isDark = getThemePreference() === Theme.Dark;
  document.documentElement.classList[isDark ? "add" : "remove"](
    DARK_THEME_CLASS,
  );

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark =
        document.documentElement.classList.contains(DARK_THEME_CLASS);
      localStorage.setItem(
        THEME_STORAGE_KEY,
        isDark ? Theme.Dark : Theme.Light,
      );
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>
<!doctype html>
<html lang={documentLang}>
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
