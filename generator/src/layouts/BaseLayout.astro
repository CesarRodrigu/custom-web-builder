---
import { defaultLocale, type Locale } from "@/config/site";
import Head from "@/components/Head.astro";
import "@/styles/global.css";

interface Props {
  /** Title of the page, without the site name. */
  title?: string;
  /** Meta description of the page; one derived from the title is used when omitted. */
  description?: string;
  /** Language of the page content; the locale of the current route is used when omitted. */
  lang?: Locale;
}

const { title, description, lang } = Astro.props;
const routeLocale = Astro.currentLocale as Locale | undefined;
const documentLang = lang ?? routeLocale ?? defaultLocale;
---

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>
<!doctype html>
<html lang={documentLang}>
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
