---
import ConfigEditor from "@/features/builder/ConfigEditor";
import type { BuilderTexts } from "@/features/builder/builder-texts";
import { Toaster } from "@/components/ui/toast";

/**
 * Localized strings for the home page.
 *
 * Exported so every locale page can type its `texts` object and get the same
 * compile-time check; the object literal is the only thing that differs
 * between locales.
 */
export interface HomeTexts {
  /** Human-readable page title, used for `<title>` and meta description. */
  pageTitle: string;
  /** Localized strings of the configuration editor island. */
  editor: BuilderTexts;
}

interface Props {
  /** Localized strings for this locale; the only difference between locales. */
  texts: HomeTexts;
}

const { texts } = Astro.props;
---

<ConfigEditor client:load texts={texts.editor} />
<Toaster client:load />
