{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "folder": {
      "type": "string"
    },
    "shortDescription": {
      "type": "string"
    },
    "longDescription": {
      "type": "string"
    },
    "stock": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": ["recommended", "not-for-sale"]
    },
    "mainImage": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "sku",
    "name",
    "price",
    "categories",
    "shortDescription",
    "mainImage",
    "images"
  ],
  "additionalProperties": false
}
