---
import ProductDetail, {
  type ProductDetailTexts,
} from "@/components/ProductDetail.astro";
import { site } from "@/config/site-content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProductStaticPaths } from "@/lib/content";

const texts: ProductDetailTexts = {
  navHome: "Inicio",
  navProducts: "Productos",
  navCategories: "Categorías",
  backToProducts: "Volver a productos",
  contactCta: "Consultar disponibilidad",
  categoryLabel: "Categoría",
  statusRecommended: "Recomendado",
  statusNotForSale: "No en venta",
  stockLabel: "Stock",
  footerContact: "Contacto",
  footerRights: "Todos los derechos reservados.",
};

export const getStaticPaths = getProductStaticPaths;

const { product, categories } = Astro.props;
---

<BaseLayout
  title={product.name}
  description={product.longDescription ?? product.shortDescription}
  siteName={site.name}
  contactEmail={site.contactEmail}
  layout={texts}
>
  <ProductDetail
    texts={texts}
    product={product}
    site={site}
    categories={categories}
  />
</BaseLayout>
