---
import ProductCard from "@/components/ProductCard.astro";
import { BreadcrumbTrail } from "@/components/BreadcrumbTrail";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Separator } from "@/components/ui/separator";
import type { ProductTexts } from "@/config/catalog";
import { defaultLocale, type SiteLayoutTexts } from "@/config/site";
import { sortProductsForDisplay } from "@/lib/catalog";
import type { CatalogCategory } from "@/lib/category";
import { getRelativeLocaleUrl } from "astro:i18n";

/**
 * Localized strings for a category page.
 *
 * Exported so every locale page can type its `texts` object and get the same
 * compile-time check; the object literal is the only thing that differs
 * between locales.
 */
export interface CategoryTexts extends SiteLayoutTexts, ProductTexts {
  /** Small badge shown above the category name. */
  eyebrow: string;
  /** Message shown when the category references no products. */
  empty: string;
  /** Link back to the full products page. */
  backToProducts: string;
}

interface Props {
  /** Localized strings of the page. */
  texts: CategoryTexts;
  /** Category exported by the generator, with its referenced products resolved. */
  category: CatalogCategory;
}

const { texts, category } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const sortedProducts = sortProductsForDisplay(category.products, locale);
const homeHref = getRelativeLocaleUrl(locale, "/");
const productsHref = getRelativeLocaleUrl(locale, "/products");
const categoriesHref = getRelativeLocaleUrl(locale, "/categories");
const breadcrumbItems = [
  { label: texts.navHome, href: homeHref },
  { label: texts.navCategories, href: categoriesHref },
  { label: category.name },
];
---

<main class="min-h-[60vh]">
  <section class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <BreadcrumbTrail items={breadcrumbItems} />

    <header class="mt-8 flex flex-col gap-3">
      <Badge variant="secondary">{texts.eyebrow}</Badge>
      <h1 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
        {category.name}
      </h1>
      {category.description && (
        <p class="max-w-2xl text-muted-foreground">{category.description}</p>
      )}
    </header>
    <Separator className="mt-8" />

    {sortedProducts.length === 0 ? (
      <p class="py-16 text-center text-muted-foreground">{texts.empty}</p>
    ) : (
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sortedProducts.map((product) => (
          <li>
            <ProductCard product={product} locale={locale} texts={texts} />
          </li>
        ))}
      </ul>
    )}

    <a
      class={`${buttonVariants({ variant: "outline", size: "lg" })} mt-10`}
      href={productsHref}
    >
      ← {texts.backToProducts}
    </a>
  </section>
</main>
