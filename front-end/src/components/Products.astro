---
import ProductCard from "@/components/ProductCard.astro";
import { BreadcrumbTrail } from "@/components/BreadcrumbTrail";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Separator } from "@/components/ui/separator";
import type { ProductTexts } from "@/config/catalog";
import { defaultLocale, type SiteLayoutTexts } from "@/config/site";
import type { CatalogProduct } from "@/lib/catalog";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Page } from "astro";

/**
 * Localized strings for the products page.
 *
 * Exported so every locale page can type its `texts` object and get the same
 * compile-time check; the object literal is the only thing that differs
 * between locales.
 */
export interface ProductsTexts extends SiteLayoutTexts, ProductTexts {
  /** Human-readable page title, used for `<title>` and the meta description. */
  pageTitle: string;
  /** Small badge shown above the page heading. */
  eyebrow: string;
  /** Main heading of the page. */
  heading: string;
  /** Supporting text shown under the heading. */
  intro: string;
  /** Message shown when the exported catalog has no products. */
  empty: string;
  /** Accessible label of the pagination navigation. */
  paginationLabel: string;
  /** Label of the link to the previous catalog page. */
  paginationPrevious: string;
  /** Label of the link to the next catalog page. */
  paginationNext: string;
  /** Prefix of the accessible label of each numbered page link. */
  paginationPage: string;
}

interface Props {
  /** Localized strings of the page. */
  texts: ProductsTexts;
  /** Page data from Astro's paginate function. */
  page: Page<CatalogProduct>;
}

const { texts, page } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const { data: products, currentPage, lastPage } = page;
const productsHref = getRelativeLocaleUrl(locale, "/products");
const pageItems = Array.from({ length: lastPage }, (_, index) => {
  const number = index + 1;

  return {
    number,
    href:
      number === 1
        ? productsHref
        : getRelativeLocaleUrl(locale, `/products/page/${number}`),
    current: number === currentPage,
  };
});
const previousHref =
  currentPage > 1 ? pageItems[currentPage - 2]?.href : undefined;
const nextHref =
  currentPage < lastPage ? pageItems[currentPage]?.href : undefined;
const breadcrumbItems = [
  {
    label: texts.navHome,
    href: getRelativeLocaleUrl(locale, "/"),
  },
  { label: texts.navProducts },
];
---

<main class="min-h-[60vh]">
  <section class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <BreadcrumbTrail items={breadcrumbItems} />

    <header class="mt-8 flex flex-col gap-3">
      <Badge variant="secondary">{texts.eyebrow}</Badge>
      <h1 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
        {texts.heading}
      </h1>
      <p class="max-w-2xl text-muted-foreground">{texts.intro}</p>
    </header>
    <Separator className="mt-8" />

    {products.length === 0 ? (
      <p class="py-16 text-center text-muted-foreground">{texts.empty}</p>
    ) : (
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <li>
            <ProductCard product={product} locale={locale} texts={texts} />
          </li>
        ))}
      </ul>
    )}

    {lastPage > 1 && (
      <nav
        aria-label={texts.paginationLabel}
        class="mt-10 flex flex-wrap items-center justify-center gap-2"
        data-testid="products-pagination"
      >
        {previousHref ? (
          <a
            href={previousHref}
            rel="prev"
            class={buttonVariants({ variant: "outline", size: "sm" })}
          >
            ← {texts.paginationPrevious}
          </a>
        ) : (
          <span
            aria-disabled="true"
            class={`${buttonVariants({ variant: "outline", size: "sm" })} opacity-50`}
          >
            ← {texts.paginationPrevious}
          </span>
        )}

        {pageItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? "page" : undefined}
            aria-label={`${texts.paginationPage} ${item.number}`}
            class={buttonVariants({
              variant: item.current ? "default" : "outline",
              size: "icon-sm",
            })}
            data-testid="pagination-page"
          >
            {item.number}
          </a>
        ))}

        {nextHref ? (
          <a
            href={nextHref}
            rel="next"
            class={buttonVariants({ variant: "outline", size: "sm" })}
          >
            {texts.paginationNext} →
          </a>
        ) : (
          <span
            aria-disabled="true"
            class={`${buttonVariants({ variant: "outline", size: "sm" })} opacity-50`}
          >
            {texts.paginationNext} →
          </span>
        )}
      </nav>
    )}
  </section>
</main>
